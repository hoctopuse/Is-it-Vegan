    },
    {
      "id": "efsa-e322-2017",
      "title": "Re-evaluation of lecithins (E 322) as a food additive",
      "publisher": "European Food Safety Authority",
      "url": "https://doi.org/10.2903/j.efsa.2017.4742",
      "role": "Primary scientific review confirming that E322 may be obtained from animal or vegetable foodstuffs, including soy and egg-yolk sources",
      "caveat": "Safety assessment and source description; it is not a vegan certification."
    },
    {
      "id": "efsa-e471-2017",
      "title": "Re-evaluation of mono- and di-glycerides of fatty acids (E 471) as food additives",
      "publisher": "European Food Safety Authority",
      "url": "https://doi.org/10.2903/j.efsa.2017.5045",
      "role": "Primary scientific review for the identity and manufacture of E471",
      "caveat": "Safety assessment; it does not classify E471 as vegan and does not identify the source of a particular product."
    },
    {
      "id": "food-info-e630",
      "title": "E630 Inosinic acid",
      "publisher": "Food-Info.net, Stichting Food-Info",
      "url": "https://www.food-info.net/uk/e/e630.htm",
