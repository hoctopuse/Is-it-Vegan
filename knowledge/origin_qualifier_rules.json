{
  "schemaVersion": 1,
  "title": "Origin qualifiers for vegan assessment",
  "purpose": "Resolve an otherwise uncertain ingredient only when an explicit origin qualifier is syntactically attached to that ingredient or additive.",
  "reviewedOn": "2026-09-21",
  "limitations": [
    "This is a cautious candidate list based on Food-Info (Stichting Food-Info), not an EU vegan-status list or a certification.",
    "Food-Info's animal-origin overview is not a current regulatory authorisation list; the presence of an E-number here does not assert that it is currently authorised for every use in the EU.",
    "An origin qualifier resolves only its own ingredient/additive. A separate mention of vegetable oils must never resolve E471 or another additive.",
    "If the parser cannot establish the local attachment of the qualifier, keep the ingredient UNCERTAIN."
  ],
  "sources": [
    {
      "id": "food-info-animal-origin-overview",
      "title": "Which E-numbers and additives are from animal origin?",
      "publisher": "Food-Info.net, Stichting Food-Info",
      "url": "https://www.food-info.net/uk/qa/qa-fi45.htm",
      "role": "Secondary overview for identifying origin-variable additives",
      "caveat": "Use as a research lead; not a regulatory source and not a substitute for current manufacturer specifications."
    },
    {
      "id": "food-info-e322",
      "title": "E322 Lecithin",
      "publisher": "Food-Info.net, Stichting Food-Info",
      "url": "https://www.food-info.net/uk/e/e322.htm",
      "role": "Supports soy versus egg yolk as commercial lecithin sources"
    },
    {
      "id": "food-info-e471",
      "title": "E471 Mono- and diglycerides",
      "publisher": "Food-Info.net, Stichting Food-Info",
      "url": "https://www.food-info.net/uk/e/e471.htm",
      "role": "Supports plant or animal fat origins and says the producer is needed to establish the exact source"
    },
    {
      "id": "food-info-e630",
      "title": "E630 Inosinic acid",
      "publisher": "Food-Info.net, Stichting Food-Info",
      "url": "https://www.food-info.net/uk/e/e630.htm",
      "role": "Supports meat/fish or bacterial-fermentation origins for E630"
    }
  ],
  "attachmentPolicy": {
    "qualifierMustAttachToSameIngredient": true,
    "acceptedExamples": [
      "lécithines (soja)",
      "E471 d'origine végétale",
      "E471 (acides gras d'origine végétale)",
      "E630 issu de fermentation bactérienne"
    ],
    "rejectedExamples": [
      "huiles végétales (palme, tournesol), émulsifiant : E471",
      "E471, huiles végétales (palme, tournesol)",
      "E471 (origine non précisée)"
    ],
    "notes": [
      "Do not infer an additive's source from another ingredient, another composite child, or a distant parenthetical.",
      "A general animal-origin statement proves NOT_VEGAN, but does not always determine the vegetarian sub-class; retain that distinction where the engine models it."
    ]
  },
  "rules": [
    {
      "id": "lecithin-e322",
      "targets": ["E322", "lécithine", "lecithine", "lecithins"],
      "originMode": "variable",
      "evidenceLevel": "direct-item-source-description",
      "sourceIds": ["food-info-e322", "food-info-animal-origin-overview"],
      "qualifierOutcomes": [
        {
          "origin": "plant-soy",
          "qualifiers": ["soja", "soy", "soya", "soybean", "sojaboon"],
          "veganStatus": "VEGAN",
          "vegetarianStatus": "VEGETARIAN_OR_VEGAN"
        },
        {
          "origin": "egg",
          "qualifiers": ["œuf", "oeuf", "egg", "ei", "eigeel", "jaune d'œuf", "jaune d'oeuf"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "VEGETARIAN"
        }
      ],
      "unresolvedStatus": "UNCERTAIN",
      "caveat": "Only resolve when the soy/egg wording labels the lecithin source, e.g. 'lécithines (soja)'."
    },
    {
      "id": "fatty-acid-derived-additives",
      "targets": [
        "E430", "E431", "E432", "E433", "E434", "E435", "E436",
        "E470", "E471", "E472", "E473", "E474", "E475", "E477", "E478", "E479", "E479b",
        "E481", "E482", "E483", "E484",
        "E491", "E492", "E493", "E494", "E495",
        "E570", "E571", "E572", "E573"
      ],
      "originMode": "variable",
      "evidenceLevel": "secondary-overview; verify exact additive and current production",
      "sourceIds": ["food-info-animal-origin-overview", "food-info-e471"],
      "qualifierOutcomes": [
        {
          "origin": "plant",
          "qualifiers": ["d'origine végétale", "d’origine végétale", "origine végétale", "végétal", "végétale", "vegetal", "vegetable", "plant-based", "soja", "soy", "soya", "palme", "palm", "tournesol", "sunflower", "colza", "rapeseed", "coco", "coconut"],
          "veganStatus": "VEGAN",
          "vegetarianStatus": "VEGETARIAN_OR_VEGAN"
        },
        {
          "origin": "animal-unspecified",
          "qualifiers": ["d'origine animale", "d’origine animale", "origine animale", "animal", "animal-derived", "graisse animale", "animal fat"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "UNCERTAIN"
        },
        {
          "origin": "meat-or-fish",
          "qualifiers": ["porc", "pork", "bœuf", "boeuf", "beef", "viande", "meat", "poisson", "fish", "sardine"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "NON_VEGETARIAN"
        }
      ],
      "unresolvedStatus": "UNCERTAIN",
      "caveat": "The origin must explicitly qualify the additive itself. A nearby but separately listed 'huiles végétales' is not evidence for E471. Exclude E476: the reviewed Food-Info overview describes it as synthetic vegetable fat."
    },
    {
      "id": "glycerol-e422",
      "targets": ["E422", "glycérol", "glycerol", "glycerine", "glycerin"],
      "originMode": "variable",
      "evidenceLevel": "secondary-overview; not independently corroborated in this review",
      "sourceIds": ["food-info-animal-origin-overview"],
      "qualifierOutcomes": [
        {
          "origin": "synthetic-non-animal",
          "qualifiers": ["synthétique", "synthetic"],
          "veganStatus": "VEGAN",
          "vegetarianStatus": "VEGETARIAN_OR_VEGAN"
        },
        {
          "origin": "animal",
          "qualifiers": ["animal", "animale", "graisse animale", "animal fat"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "UNCERTAIN"
        }
      ],
      "unresolvedStatus": "UNCERTAIN",
      "activation": "REVIEW_BEFORE_ENGINE_USE"
    },
    {
      "id": "inosinates-e626-e629-e630-e635",
      "targets": ["E626", "E627", "E628", "E629", "E630", "E631", "E632", "E633", "E634", "E635"],
      "originMode": "variable",
      "evidenceLevel": "secondary-overview; E630 page individually checked",
      "sourceIds": ["food-info-animal-origin-overview", "food-info-e630"],
      "qualifierOutcomes": [
        {
          "origin": "microbial-fermentation-or-yeast",
          "qualifiers": ["levure", "yeast", "fermentation", "bactérienne", "bacterial", "microbienne", "microbial"],
          "veganStatus": "VEGAN",
          "vegetarianStatus": "VEGETARIAN_OR_VEGAN"
        },
        {
          "origin": "meat-or-fish",
          "qualifiers": ["viande", "meat", "poisson", "fish", "sardine", "extrait de viande", "meat extract"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "NON_VEGETARIAN"
        }
      ],
      "unresolvedStatus": "UNCERTAIN",
      "activation": "REVIEW_BEFORE_ENGINE_USE",
      "caveat": "Food-Info specifically describes E630 as commercially meat/fish-derived but also producible by bacterial fermentation; do not generalise that exact manufacturing distribution to every code without checking its specification."
    },
    {
      "id": "glycine-e640",
      "targets": ["E640", "glycine", "glycine"],
      "originMode": "variable",
      "evidenceLevel": "secondary-overview only",
      "sourceIds": ["food-info-animal-origin-overview"],
      "qualifierOutcomes": [
        {
          "origin": "synthetic-non-animal",
          "qualifiers": ["synthétique", "synthetic"],
          "veganStatus": "VEGAN",
          "vegetarianStatus": "VEGETARIAN_OR_VEGAN"
        },
        {
          "origin": "gelatine",
          "qualifiers": ["gélatine", "gelatine", "gelatin"],
          "veganStatus": "NOT_VEGAN",
          "vegetarianStatus": "UNCERTAIN"
        }
      ],
      "unresolvedStatus": "UNCERTAIN",
      "activation": "REVIEW_BEFORE_ENGINE_USE"
    }
  ],
  "notOriginResolverRules": [
    {
      "id": "unambiguous-animal-ingredients",
      "examples": ["lait", "œuf", "porc", "gélatine"],
      "handling": "Match as ordinary ingredients; do not require parentheses to establish their known classification."
    },
    {
      "id": "vegetable-oils",
      "examples": ["huile végétale", "huiles végétales (palme, tournesol)"],
      "handling": "Classify the oil wording itself. Never use its parentheses to resolve a different additive."
    }
  ]
}
